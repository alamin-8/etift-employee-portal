PORT=5000
HOST=0.0.0.0
NODE_ENV=development
# Public URL encoded in attendance QR codes (for example, https://portal.example.com).
# Leave unset locally to use the computer's LAN address.
PUBLIC_URL=
# Optional comma-separated list of allowed front-end origins for CORS.
# Example: https://portal.example.com,https://www.portal.example.com
ALLOWED_ORIGINS=
SESSION_SECRET=etift_session_secret
JWT_SECRET=etift_secret_key_2026
